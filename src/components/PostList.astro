---
import PostCard from './PostCard.astro';
import type { Post } from '../lib';

interface Props { posts: Post[]; showSection?: boolean }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="muted">첫 글을 준비하고 있습니다.</p>
) : (
  <div class="card-grid">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
)}
