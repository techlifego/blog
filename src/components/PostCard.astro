---
// 글 카드: 대표 그림(없으면 구역 아이콘 자리) · 구역 · 제목 · 설명 · 날짜
import SectionIcon from './SectionIcon.astro';
import { SECTIONS } from '../site.config';
import { postUrl, formatDate, type Post } from '../lib';
interface Props { post: Post; mini?: boolean }
const { post: p, mini = false } = Astro.props;
const d = p.data;
---
<a class:list={['card', { mini }]} href={postUrl(p)}>
  <div class:list={['thumb', `sec-${d.section}`]}>
    {d.image ? <img src={d.image} alt="" loading="lazy" decoding="async" width="1200" height="630" /> : <SectionIcon section={d.section} size={mini ? 22 : 40} />}
  </div>
  <div class="card-body">
    {!mini && <span class:list={['chip', `sec-${d.section}`]}><SectionIcon section={d.section} size={14} />{SECTIONS[d.section].name}</span>}
    <strong class="card-title">{d.title}{d.draft && <span class="draft-badge">초안</span>}</strong>
    {!mini && <span class="card-desc">{d.description}</span>}
    <time class="card-date" datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
  </div>
</a>
