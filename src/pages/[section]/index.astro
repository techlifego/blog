---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import { SECTIONS, SECTION_KEYS, type SectionKey } from '../../site.config';
import { getPosts } from '../../lib';

export function getStaticPaths() {
  return SECTION_KEYS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionKey;
const info = SECTIONS[section];
const posts = await getPosts(section);
---
<Base title={info.name} description={info.description}>
  <link slot="head" rel="alternate" type="application/rss+xml" href={`/${section}/rss.xml`} />
  <section class={`sec-head sec-${section}`}>
    <span class="sec-badge"><SectionIcon section={section} size={30} /></span>
    <div><h1>{info.name}</h1><p class="muted">{info.description} · <a href={`/${section}/rss.xml`}>RSS</a></p></div>
  </section>
  <PostList posts={posts} />
</Base>
